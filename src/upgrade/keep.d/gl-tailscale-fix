# gl-tailscale-fix — sysupgrade persistence
# Plugin files preserved through GL firmware upgrades (including 4.8.x → 4.9+).
# The plugin stays fully active across minor and major firmware upgrades;
# per-feature UI gating handles overlaps with GL's native Tailscale features
# on 4.9+ (see src/rpc/ts-fix detect_firmware / src/www/ts-fix.js).

# UCI config (user settings)
/etc/config/ts-fix

# Plugin components
/usr/lib/oui-httpd/rpc/ts-fix
/etc/init.d/ts-fix
/etc/init.d/ts-fix-preboot
/etc/hotplug.d/iface/10-ts-fix-ks
/etc/hotplug.d/iface/20-ts-fix
/etc/hotplug.d/iface/98-ts-fix-isolate6
/usr/bin/ts-fix-ks
/usr/bin/ts-fix-reapply
/usr/bin/ts-fix-watchdog
/usr/bin/ts-fix-update
/usr/bin/ts-fix-isolate6
/etc/nginx/gl-conf.d/ts-fix.conf
/usr/share/ts-fix/

# This file (self-preservation for next sysupgrade)
/lib/upgrade/keep.d/gl-tailscale-fix

# Procd service symlink (auto-start after sysupgrade). Only the S symlink exists —
# the init script declares no STOP=, so enable never creates a K symlink.
# S99 matches START=99 in the init script: the kill switch's zone layer is applied from flash by
# the firewall's own boot and its rule layer is re-installed after netifd's start by the
# 10-ts-fix-ks hotplug handler, so nothing here needs to precede netifd any more.
/etc/rc.d/S99ts-fix

# Pre-firewall kill-switch pass symlink (S18 = START=18 in /etc/init.d/ts-fix-preboot; no STOP=,
# so again only the S link exists). This one MUST survive a firmware upgrade: the first boot after
# a keep-settings upgrade — when GL's first-boot defaults re-enable the severed forwardings — is
# the boot the preboot pass exists for, and without the link it would not run on it.
/etc/rc.d/S18ts-fix-preboot

# The Tailscale binaries (/usr/sbin/tailscaled, /usr/sbin/tailscale) are NOT listed here. When the
# Version Manager installs a binary, /usr/bin/ts-fix-update writes a second list naming them,
# /lib/upgrade/keep.d/gl-tailscale-fix-tailscale, and Restore deletes it. A firmware upgrade that
# keeps settings copies every listed path that exists, so listing them here carried the old
# firmware's own Tailscale over the new firmware's (measured on a 4.8.5 → 4.9.0 upgrade).
